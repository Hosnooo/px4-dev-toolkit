// ROS 2 -> PX4 Offboard control-level heartbeat.
PX4_TOPIC(IN_OFFBOARD_CONTROL_MODE, "/fmu/in/offboard_control_mode")

// ROS 2 -> PX4 position/velocity/acceleration trajectory setpoint.
PX4_TOPIC(IN_TRAJECTORY_SETPOINT, "/fmu/in/trajectory_setpoint")

// ROS 2 -> PX4 discrete vehicle commands.
PX4_TOPIC(IN_VEHICLE_COMMAND, "/fmu/in/vehicle_command")

// Final actuator commands produced by PX4 control allocation.
PX4_TOPIC(OUT_ACTUATOR_MOTORS, "/fmu/out/actuator_motors")

// Battery state reported by PX4.
PX4_TOPIC(OUT_BATTERY_STATUS, "/fmu/out/battery_status")

// Estimator health and validity flags.
PX4_TOPIC(OUT_ESTIMATOR_STATUS_FLAGS, "/fmu/out/estimator_status_flags")

// Active PX4 failsafe conditions.
PX4_TOPIC(OUT_FAILSAFE_FLAGS, "/fmu/out/failsafe_flags")

// Manual-control input selected by PX4.
PX4_TOPIC(OUT_MANUAL_CONTROL_SETPOINT, "/fmu/out/manual_control_setpoint")

// Completion result for PX4 navigation modes that report completion.
PX4_TOPIC(OUT_MODE_COMPLETED, "/fmu/out/mode_completed")

// Native PX4 position/velocity/acceleration trajectory reference.
PX4_TOPIC(OUT_TRAJECTORY_SETPOINT, "/fmu/out/trajectory_setpoint")

// Measured body angular velocity used by the rate controller.
PX4_TOPIC(OUT_VEHICLE_ANGULAR_VELOCITY, "/fmu/out/vehicle_angular_velocity")

// Estimated vehicle attitude quaternion.
PX4_TOPIC(OUT_VEHICLE_ATTITUDE, "/fmu/out/vehicle_attitude")

// Desired attitude generated for the attitude controller.
PX4_TOPIC(OUT_VEHICLE_ATTITUDE_SETPOINT, "/fmu/out/vehicle_attitude_setpoint")

// PX4 acknowledgement of a received VehicleCommand.
PX4_TOPIC(OUT_VEHICLE_COMMAND_ACK, "/fmu/out/vehicle_command_ack")

// Current PX4 control-mode enable flags.
PX4_TOPIC(OUT_VEHICLE_CONTROL_MODE, "/fmu/out/vehicle_control_mode")

// PX4 land-detection state.
PX4_TOPIC(OUT_VEHICLE_LAND_DETECTED, "/fmu/out/vehicle_land_detected")

// Estimated local position and velocity in NED.
PX4_TOPIC(OUT_VEHICLE_LOCAL_POSITION, "/fmu/out/vehicle_local_position")

// Position-controller setpoint telemetry after PX4 trajectory processing.
PX4_TOPIC(OUT_VEHICLE_LOCAL_POSITION_SETPOINT, "/fmu/out/vehicle_local_position_setpoint")

// Vehicle pose, velocity, and angular-rate odometry.
PX4_TOPIC(OUT_VEHICLE_ODOMETRY, "/fmu/out/vehicle_odometry")

// Desired body rates generated by the attitude controller.
PX4_TOPIC(OUT_VEHICLE_RATES_SETPOINT, "/fmu/out/vehicle_rates_setpoint")

// PX4 arming and navigation-state status used by ROS 2.
PX4_TOPIC(OUT_VEHICLE_STATUS_V1, "/fmu/out/vehicle_status_v1")

// Normalized thrust command produced by the controller.
PX4_TOPIC(OUT_VEHICLE_THRUST_SETPOINT, "/fmu/out/vehicle_thrust_setpoint")

// Torque command produced by the rate controller.
PX4_TOPIC(OUT_VEHICLE_TORQUE_SETPOINT, "/fmu/out/vehicle_torque_setpoint")
