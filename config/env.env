# Runtime configuration shared by the local PX4/ROS 2 tools.
# Keep launch-time choices here so tools/sitl and ROS launch files use the
# same model, world, transport, and ground-control settings.

# ROS 2 distribution sourced by ros2/runtime_env.sh.
ROS_DISTRO=jazzy

# PX4 SITL target, Gazebo vehicle model, and Gazebo world.
PX4_BUILD_TARGET=px4_sitl
PX4_SIM_MODEL=gz_f450
PX4_GZ_WORLD=default

# EKF2 localization: Gazebo odometry + IMU only.
# External vision supplies position, height, velocity, and yaw.
# Other estimator aiding sources are disabled explicitly.
PX4_PARAM_EKF2_EV_CTRL=15
PX4_PARAM_EKF2_GPS_CTRL=0
PX4_PARAM_EKF2_HGT_REF=3
PX4_PARAM_EKF2_BARO_CTRL=0
PX4_PARAM_EKF2_MAG_TYPE=5
PX4_PARAM_EKF2_RNG_CTRL=0
PX4_PARAM_EKF2_OF_CTRL=0

# PX4 <-> ROS 2 uXRCE-DDS agent endpoint.
XRCE_AGENT_TRANSPORT=udp4
XRCE_AGENT_PORT=8888

# MAVProxy connects to PX4's default GCS MAVLink endpoint.
MAVPROXY_MASTER=udp:127.0.0.1:14550

# Optional services started by tools/sitl.
START_XRCE_AGENT=true

# Ground-control frontend started with SITL: qgc | mavproxy | none.
GCS=mavproxy

# tmux session used to group the SITL processes.
TMUX_SESSION=px4-sitl
