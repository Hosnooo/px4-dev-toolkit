#!/usr/bin/python3 -s

"""Analyze one recorded PX4 experiment bag."""

from __future__ import annotations

from pathlib import Path
import sys


def find_repo_root() -> Path:
    """Locate px4_env from this executable."""
    start = Path(__file__).resolve()

    for path in (
        start.parent,
        *start.parents,
    ):
        if (
            (path / "px4_env.repos").is_file()
            and (path / "analysis").is_dir()
            and (path / "ros2").is_dir()
        ):
            return path

    raise RuntimeError(
        "Could not locate px4_env repository root "
        f"from {start}"
    )


ROOT = find_repo_root()
sys.path.insert(
    0,
    str(ROOT),
)

from analysis.core import read_bag  # noqa: E402
from analysis.profiles import (  # noqa: E402
    detect_profile_name,
    get_profile,
)


def main() -> int:
    if len(sys.argv) != 2:
        print("Usage:")
        print(
            "  ./tools/px4_analyze "
            "<bag-directory>"
        )
        return 2

    bag_path = (
        Path(sys.argv[1])
        .expanduser()
        .resolve()
    )

    if not bag_path.is_dir():
        raise RuntimeError(
            "Bag directory does not exist: "
            f"{bag_path}"
        )

    profile_name = detect_profile_name(
        bag_path
    )
    profile = get_profile(
        profile_name
    )

    bag = read_bag(
        bag_path,
        profile.REQUIRED_TOPICS,
        getattr(
            profile,
            "OPTIONAL_TOPICS",
            (),
        ),
    )
    result = profile.analyze(bag)

    output_dir = (
        bag_path / "analysis"
    )
    output_dir.mkdir(
        exist_ok=True
    )

    summary_path = (
        output_dir / "summary.txt"
    )
    summary_path.write_text(
        result.summary
    )

    print(
        result.summary,
        end="",
    )
    print(
        f"Summary: {summary_path}"
    )

    try:
        generated = profile.write_plots(
            result,
            output_dir,
        )
    except RuntimeError as exc:
        print(
            f"WARNING: {exc}",
            file=sys.stderr,
        )
        return 0

    for path in generated:
        print(f"Plot: {path}")

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (
        RuntimeError,
        ValueError,
    ) as exc:
        print(
            f"ERROR: {exc}",
            file=sys.stderr,
        )
        raise SystemExit(1)
