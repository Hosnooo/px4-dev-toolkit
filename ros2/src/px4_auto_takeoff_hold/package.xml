<?xml version="1.0"?>
<package format="3">
  <name>px4_auto_takeoff_hold</name>
  <version>0.1.0</version>
  <description>ROS 2 package for PX4 native arming, automatic takeoff, hold, and experiment recording.</description>

  <maintainer email="mohssen.elshaar@gmail.com">Mohssene</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>

  <!-- Runtime dependencies used only by the Python launch orchestration. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosbag2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
